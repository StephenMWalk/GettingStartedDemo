    <chapter xml:id="homework">
      <title>Homework</title>

  <worksheet>
  <title>Homework xx</title>
  <introduction>
    <p>
      <alert>Instructions:</alert> etc.
    </p>
  </introduction>

  <page>
    <exercise workspace="1in">
      <statement>
        <p>
          <em>[BASIC] Average value of a continuous function.</em>  Find the average value of the function <m>f(t) = t \sin(t^2)</m> on the interval <m>[0, 20]</m>.  Round your answer to <em>THREE</em> decimal places.  <em>Remember that in calculus, angles are measured in radians rather than in degrees.</em>
        </p>
      </statement>
    </exercise>

  </page>
</worksheet>


    </chapter>

